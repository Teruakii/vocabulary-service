# Copy to .env and fill in. .env is git-ignored.

APP_ENV=development
PORT=8085
APP_NAME=vocabulary-service

DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=root
DB_PASSWORD=root
DB_NAME=vocabulary_db

# Required. Use a long random string, e.g. `openssl rand -hex 32`.
JWT_SECRET_KEY=

# Optional: Google sign-in. All three must be set to enable it.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5173/api/v1/auth/google/callback

# Where the Google callback and password reset links send the browser.
FRONTEND_URL=http://localhost:5173

# Comma-separated. These accounts become admin once their email is verified.
ADMIN_EMAILS=

# Optional: password reset email. Without SMTP_HOST, development logs the
# reset link instead and production turns password reset off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
